{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "buildCS",
            "command": "dotnet",
            "args": [
                "build",
            ],
            "options": { "cwd": "${workspaceFolder}" },

            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildCPP",

            "type": "shell",
            "command": "./build_editor.py",
            "options": { "cwd": "${workspaceFolder}" },
            
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildCPPdev",

            "type": "shell",
            "command": "./build_editor.py",
            "args": [
                "--dev",
            ],
            "options": { "cwd": "${workspaceFolder}" },
            
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildFull",
            "dependsOn": [
                "buildCPP",
                "buildCS"
            ],
            "dependsOrder": "sequence",
        },
    ]
}
