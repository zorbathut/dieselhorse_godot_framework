<Project Sdk="Godot.NET.Sdk/4.4.1-tsoh">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>13</LangVersion>

    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <GodotFloat64>true</GodotFloat64>

    <!-- "member" hides "other member" -->
    <WarningsAsErrors>CS0108</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="dec/**" />
    <Content Include="src/**/*.md" />
    <Content Include="thirdparty\.gitignore" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="thirdparty/arbor/arbor-generator/**/*" />
    <ProjectReference Include="thirdparty/arbor/arbor-generator/arbor-generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

    <Compile Remove="thirdparty/greact/greact-generator/**/*" />
    <ProjectReference Include="thirdparty\greact\greact-generator\greact-generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

    <Compile Remove="thirdparty/gdunit4/**/*" />
    <ProjectReference Include="thirdparty\gdunit4\testadapter\gdUnit4TestAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.4.0" />
    <PackageReference Include="ConcurrentHashSet" Version="1.3.0" />
    <PackageReference Include="Sentry" Version="5.1.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.7.4" />

    <!-- tests don't show up without this (why not?) -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="src\monster\ai\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- this is apparently Rider-specific -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/tsoh.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <Target Name="SaveBuildOutputPath" AfterTargets="Build">
    <PropertyGroup>
      <OutputPathInfoFile>$(MSBuildProjectDirectory)\.godot\mono\temp\LastBuild.txt</OutputPathInfoFile>
    </PropertyGroup>

    <WriteLinesToFile File="$(OutputPathInfoFile)"
                      Lines="$(Configuration)"
                      Overwrite="true" />

    <Message Text="Build configuration `$(Configuration)` saved to: $(OutputPathInfoFile)" Importance="high" />
  </Target>
</Project>
