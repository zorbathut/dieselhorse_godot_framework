config_version=5

[application]

config/name="moonskrive"
run/main_scene="res://global/bootstrap.tscn"
config/features=PackedStringArray("4.2", "C#", "Double Precision", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="moonskrive"

