pipeline {
    agent any
    
    environment {
        GBCMSB_ID = "gbcmsb-${BUILD_NUMBER}"
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    docker.image("quay.io/podman/stable:v5.0.2-immutable").inside('--privileged') {
                        dir('build/godot-build-containers') {
                            sh './msb.sh'
                        }
                    }
                }
            }
        }
    }
}
