pipeline {
    agent any
    
    stages {
        stage('Build') {
            steps {
                script {
                    sh "(cd build/bootstrap && docker build -t my-image:${env.BUILD_ID} .)"
 
                    sh "docker run  --rm --volumes-from jenkins-agent -e VOLUMES_FROM=jenkins_agent -w ${env.WORKSPACE} my-image:${env.BUILD_ID} python tool.py deploy_full"
 
                     archiveArtifacts artifacts: "artifact/*", fingerprint: true
                }
            }
        }
    }
}
