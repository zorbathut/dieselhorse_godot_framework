pipeline {
    agent any
    
    environment {
        GBCMSB_ID = "gbcmsb-${BUILD_NUMBER}"
        
        LINUX_IMAGE_TAR = "godot-linux-${GBCMSB_ID}.tar"
        WINDOWS_IMAGE_TAR = "godot-windows-${GBCMSB_ID}.tar"
    }

    stages {
        stage('Build') {
            steps {
                script {
                    sh 'python tool.py deploy_full'

                    archiveArtifacts artifacts: "artifact/*", fingerprint: true
                }
            }
        }
    }
}
