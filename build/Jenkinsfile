pipeline {
    agent any
    
    environment {
        GBCMSB_ID = "gbcmsb-${BUILD_NUMBER}"
        
        LINUX_IMAGE_TAR = "godot-linux-${GBCMSB_ID}.tar"
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    docker.image("quay.io/podman/stable:v5.0.2-immutable").inside('--privileged -v /var/lib/jenkins/podman-storage:/var/lib/containers/storage') {
                        dir('build/godot-build-containers') {
                            sh './msb.sh'
                            
                            // export
                            sh "podman save localhost/godot-linux:${GBCMSB_ID} -o ${LINUX_IMAGE_TAR}"
                        }
                    }

                    // Import the image into the Docker environment of the Jenkins host
                    sh "docker load -i build/godot-build-containers/${LINUX_IMAGE_TAR}"
                }
            }
        }
        stage('Deploy Linux') {
            steps {
                script {
                    docker.image("localhost/godot-linux:${GBCMSB_ID}").inside {
                        sh 'python tool.py deploy'
                    }
                }
            }
        }
        stage('Create Linux artifact') {
            steps {
                script {
                    def zipFileName = 'moonskrive_linux.zip'
                    sh """
                        cd deploy
                        zip -r ${zipFileName} linux
                    """
                    archiveArtifacts artifacts: "deploy/${zipFileName}", fingerprint: true
                }
            }
        }
    }
    
    post {
        always {
            script {
                // Clean up the Docker container and image tar file
                sh '''
                    if [ $(docker ps -a -q --filter ancestor=localhost/godot-linux:${GBCMSB_ID} | wc -l) -gt 0 ]; then
                        docker rm -f $(docker ps -a -q --filter ancestor=localhost/godot-linux:${GBCMSB_ID})
                    fi
                '''
                sh "rm -f ${LINUX_IMAGE_TAR}"
            }
        }
    }
}
