pipeline {
    agent any
    
    stages {
        stage('Build') {
            steps {
                script {
                    sh "cd build/bootstrap && docker build -t my-image:${env.BUILD_ID} ."

                    sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v /etc/passwd:/etc/passwd -v /etc/group:/etc/group -v .:/workspace -w /workspace --user 1000:1000 my-image:${env.BUILD_ID} python tool.py build"

                    archiveArtifacts artifacts: "artifact/*", fingerprint: true
                }
            }
        }
    }
}
