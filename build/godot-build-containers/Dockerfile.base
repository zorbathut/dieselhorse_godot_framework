FROM fedora:41

WORKDIR /root

ENV DOTNET_NOLOGO=1
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

ENV HOME=/tmp/HOME
RUN mkdir -p $HOME

# DH BEGIN - permissions because we don't run in root (maybe we should? I forget why I don't)
RUN chmod a+rwx $HOME
# DH END - permissions because we don't run in root (maybe we should? I forget why I don't)

# DH BEGIN - dotnet sdk 9
RUN dnf -y install --setopt=install_weak_deps=False \
      bash binutils bzip2 curl file findutils gettext git make nano patch pkgconfig python3-pip unzip which xz \
      dotnet-sdk-9.0
# DH END - dotnet sdk 9

# DH BEGIN
# nutdealer framework
# python/poetry for build env
# python3-devel and gcc for building python modules
# zip and git for deploy script requirements
# it's unclear why exactly fontconfig is needed; godot refuses to run without it? I dunno what's going on there.
RUN dnf -y install --setopt=install_weak_deps=False python poetry python3-devel gcc fontconfig zip git

# annoying permission issues with docker mean that we need to set up git to accept weird-ass stuff
RUN git config --global --add safe.directory '*'

# and yet more of those
RUN chmod a+rx /root
# DH END

ENV POETRY_VIRTUALENVS_PATH=/tmp/poetry/venv
ENV POETRY_CACHE_DIR=/tmp/poetry/cache
