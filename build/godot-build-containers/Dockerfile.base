FROM fedora:39

WORKDIR /root

ENV DOTNET_NOLOGO=1
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

ENV HOME=/tmp/HOME

RUN dnf -y install --setopt=install_weak_deps=False \
      bash bzip2 curl file findutils gettext git make nano patch pkgconfig python3-pip unzip which xz \
      dotnet-sdk-8.0

# moonskrive framework
# it's unclear why exactly fontconfig is needed
RUN dnf -y install --setopt=install_weak_deps=False python poetry python3-devel gcc fontconfig

ENV POETRY_VIRTUALENVS_PATH=/tmp/poetry/venv
ENV POETRY_CACHE_DIR=/tmp/poetry/cache

CMD /bin/bash
